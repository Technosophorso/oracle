[Unit]
Description=strfry Nostr relay (relay.parles.xyz)
After=network-online.target
Wants=network-online.target

[Service]
User=strfry
Group=strfry
ExecStart=/usr/local/bin/strfry --config=/etc/strfry.conf relay
Restart=on-failure
RestartSec=5
LimitNOFILE=1000000
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/strfry

[Install]
WantedBy=multi-user.target
